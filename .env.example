# Copy to `.env` and fill in your keys. The Express API server
# (`npm run api`) loads this via dotenv.
#
# Keys live OUTSIDE the Vite client bundle — the API server is the
# only process that ever sees them, and it's only reachable on
# localhost:3001 in dev.

# Google AI Studio API key (free tier; not Vertex / GCP).
# https://aistudio.google.com/app/apikey
# Used by POST /api/import-recipe to call Gemini 2.5 Flash for
# PDF / photo recipe extraction.
GEMINI_API_KEY=

# Optional: override the default Gemini model. Defaults to
# 'gemini-2.5-flash' (cheap + fast + supports PDF + vision).
# GEMINI_MODEL=gemini-2.5-flash
