{
  "name": "flavor-network-c",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy_wasm.cjs",
    "dev": "vite",
    "build:pairings": "node scripts/buildPairingsBinary.cjs",
    "build:wasm": "node scripts/copy_wasm.cjs",
    "prebuild": "npm run build:pairings && npm run build:wasm",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node src/api/server.js",
    "gate": "node scripts/gate.cjs",
    "gate:quick": "node scripts/gate.cjs --no-build",
    "validate:pairings": "node chemDataset/validation/score_pairings.js",
    "test": "vitest run",
    "test:audit": "vitest run chemDataset/validation",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/strip-ios-bundle.mjs",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run build && npx cap sync ios && node scripts/strip-ios-bundle.mjs && cd ios/App && xcodebuild build -workspace App.xcworkspace -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator'"
  },
  "dependencies": {
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@google/generative-ai": "^0.24.1",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "firebase": "^12.10.0",
    "fuse.js": "^7.0.0",
    "multer": "^2.1.1",
    "onnxruntime-web": "^1.24.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.1",
    "onnxruntime-node": "^1.24.3",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.2"
  }
}
