{
  "version": "2.0",
  "project": {
    "name": "flavor-network",
    "expertise": [
      "full-stack"
    ]
  },
  "stack": {
    "languages": [
      "node"
    ],
    "test_runner": {
      "node": {
        "command": "npx vitest run",
        "test_dir": "src/",
        "targeted_flags": [],
        "full_flags": [],
        "ignore": []
      },
      "python": {
        "_comment": "Disabled. Auto-detection sees .py files in flavor-gnn/ + chemDataset/ (training scripts only, no pytest tests) and runs pytest, which fails with 'no tests ran' and breaks smart_gate. Empty command short-circuits the runner loop in tools/smart_gate.py run_tests().",
        "command": ""
      }
    },
    "type_checker": null,
    "linter": null
  },
  "gate": {
    "test_map": {},
    "shared_files": [],
    "secrets_scan": true,
    "denylist": [
      "\\.env(rc|\\.local|\\.production|\\.development|\\.test|\\.staging)?$",
      ".*\\.pem$",
      ".*\\.key$",
      "credentials\\.",
      "id_rsa",
      "id_ed25519"
    ],
    "manager_review": {
      "enabled": true,
      "model": "sonnet",
      "trigger": "always",
      "auto_approve_threshold": 3,
      "escalation_patterns": [
        "security",
        "database",
        "breaking-change"
      ]
    }
  },
  "harness": {
    "max_iterations": 20,
    "gate_mode": "warn",
    "timeout_seconds": 1800,
    "max_files_per_iteration": 20,
    "consecutive_fail_threshold": 3,
    "agent_model": {
      "default": "sonnet",
      "critical_tasks": "opus"
    },
    "pause_on_signals": [
      "NEEDS_REVIEW",
      "SPAWN_REQUESTED"
    ],
    "pre_commit_gate": true
  },
  "bridge": {
    "_comment_strict_disabled": "Tried strict 2026-05-29; hook fires on every Bash call (no git-commit filter), blocks `npx vitest run` before gate-pass can be called. Revert to warn until pre_commit_gate.py is patched to read stdin tool_input.command and only enforce on `git commit` prefix.",
    "enforce_gate_coupling": "warn"
  },
  "context": {
    "recent_activity_count": 5,
    "max_context_lines": 600,
    "plan_file": "plan.md",
    "activity_file": "activity.md",
    "prompt_file": "PROMPT.md"
  },
  "memories": {
    "enabled": true,
    "max_entries": 15,
    "max_bytes": 2048,
    "staleness_threshold": 10
  },
  "observations": {
    "enabled": true,
    "sync_to_global": true
  },
  "alerts": {
    "enabled": true,
    "methods": [
      "file"
    ],
    "alert_on": [
      "gate_fail_3x",
      "blocked",
      "complete",
      "timeout",
      "needs_human"
    ],
    "alert_file": ".ralph/alerts.log"
  }
}