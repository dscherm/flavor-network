    "testCommand": "bash \"$RALPH_HOME/tools/record_gate.sh\" pass \"npx vitest run\" src/components/RecipeFlavorProfilesCard.jsx src/data/recipeProfileAnalysis.js src/data/recipeProfileAnalysis.test.js 2>&1; echo \"---sidecar---\"; cat .ralph/last_gate_result.json",
